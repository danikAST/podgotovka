      { "level": "A1", "section": "Лексика", "q": "«Nerede?» — это…", "options": ["Когда?", "Где?", "Почему?", "Что?"], "correct": 1, "solution": "Nerede? — «где?». Nerede oturuyorsun? — «где ты живёшь?»" },
      { "level": "A2", "section": "Лексика", "q": "«Marketten ekmek alıyorum» — что я делаю?", "options": ["Покупаю хлеб в магазине", "Продаю хлеб в магазине", "Готовлю хлеб дома", "Ищу магазин"], "correct": 0, "solution": "Marketten ekmek alıyorum = «покупаю хлеб в магазине» (ekmek — хлеб)." },
      { "level": "A2", "section": "Понимание", "q": "Что значит «Sağa dönün»?", "options": ["Остановитесь слева", "Поверните направо", "Идите прямо", "Сверните налево"], "correct": 1, "solution": "Sağa dönün — «поверните направо» (sağ — правый)." },
      { "level": "A2", "section": "Грамматика", "q": "«Şu anda meşgulüm» — я…", "options": ["Сейчас свободен", "Сейчас занят", "Сейчас дома", "Сейчас голоден"], "correct": 1, "solution": "Şu anda meşgulüm = «сейчас я занят» (meşgul — занятой)." },
      { "level": "A2", "section": "Понимание", "q": "«Telefonum çalışmıyor» — мой телефон…", "options": ["Разрядился", "Не работает", "Звонит", "Потерялся"], "correct": 1, "solution": "Çalışmıyor — «не работает» (отрицание настоящего времени от çalışmak)." },
      { "level": "A2", "section": "Грамматика", "q": "«Bu akşam sinemaya gidiyoruz» — мы…", "options": ["Пошли в кино вчера", "Идём в кино сегодня вечером", "Пойдём в кино завтра", "Любим кино"], "correct": 1, "solution": "Bu akşam — «сегодня вечером», gidiyoruz — «мы идём» (настоящее время)." },
      { "level": "B1", "section": "Грамматика", "q": "«Geçen hafta Ankara'ya gittik» — мы…", "options": ["Поедем в Анкару", "Ездили в Анкару на прошлой неделе", "Живём в Анкаре", "Летим в Анкару завтра"], "correct": 1, "solution": "Geçen hafta — «на прошлой неделе», gittik — «мы поехали» (прошедшее время)." },
      { "level": "B1", "section": "Лексика", "q": "«Daha ucuz bir otel istiyorum» — я хочу…", "options": ["Отель поближе", "Отель подешевле", "Отель побольше", "Отель почище"], "correct": 1, "solution": "Daha ucuz — «дешевле» (daha — более, ucuz — дешёвый)." },
      { "level": "B1", "section": "Грамматика", "q": "«Eğer yağmur yağarsa, evde kalırız» — если…", "options": ["Пойдёт дождь, останемся дома", "Пойдёт снег, пойдём гулять", "Будет жарко, пойдём на пляж", "Будет ветер, отменим поездку"], "correct": 0, "solution": "Eğer … -arsa — условное предложение: «если пойдёт дождь, останемся дома»." },
      { "level": "B1", "section": "Понимание", "q": "«Hastalandım, o yüzden işe gitmedim» — я…", "options": ["Заболел, поэтому не пошёл на работу", "Выздоровел и пошёл на работу", "Опоздал на работу", "Уволился с работы"], "correct": 0, "solution": "Hastalandım — «я заболел», o yüzden — «поэтому», gitmedim — «не пошёл»." },
      { "level": "B1", "section": "Разговор", "q": "Как вежливо попросить «Скажите, пожалуйста, ещё раз»?", "options": ["Bir daha söyler misiniz?", "Ne diyorsun?", "Anlamıyorum", "Sessiz olun lütfen"], "correct": 0, "solution": "Bir daha söyler misiniz? — «не могли бы вы сказать ещё раз?» (вежливая просьба)." },
      { "level": "B2", "section": "Грамматика", "q": "«Keşke o teklifi kabul etseydim» — говорящий…", "options": ["Сожалеет, что принял предложение", "Сожалеет, что не принял предложение", "Рад, что принял предложение", "Ждёт нового предложения"], "correct": 1, "solution": "Keşke + прошедшее сослагательное — сожаление о прошлом: «вот если бы я принял то предложение»." },
      { "level": "B2", "section": "Грамматика", "q": "«Bu kitap herkes tarafından okunuyor» — книга…", "options": ["Была куплена всеми", "Читается всеми", "Будет написана всеми", "Потеряна всеми"], "correct": 1, "solution": "Okunuyor — страдательный залог настоящего времени: «читается» (от okumak)." },
      { "level": "B2", "section": "Понимание", "q": "«Söylediklerini anlıyorum ama katılmıyorum» — я…", "options": ["Не понимаю и не соглашаюсь", "Понимаю, но не согласен", "Согласен, но не понимаю", "Не слушаю тебя"], "correct": 1, "solution": "Anlıyorum — «понимаю», ama — «но», katılmıyorum — «не соглашаюсь»." },
      { "level": "B2", "section": "Грамматика", "q": "«Daha önce böyle güzel bir manzara görmemiştim» — я…", "options": ["Видел такой пейзаж раньше", "Никогда раньше не видел такого красивого пейзажа", "Хочу увидеть пейзаж", "Рисую пейзаж"], "correct": 1, "solution": "Görmemiştim — «я не видел» (прошедшее с оттенком «раньше не случалось»)." },
      { "level": "B2", "section": "Разговор", "q": "Как вежливо сказать «Если вы хотите встретиться с директором, подождите»?", "options": ["Müdürle görüşmek istiyorsanız, lütfen bekleyin", "Müdür burada yok", "Müdür ne zaman geliyor?", "Müdürle konuşmak istiyorum"], "correct": 0, "solution": "Именно эта форма — условная вежливая просьба: «если хотите увидеть директора, подождите, пожалуйста»." },
      { "level": "C1", "section": "Грамматика", "q": "«Durum ne kadar ciddi olursa olsun, pes etmeyeceğim» — я…", "options": ["Сдамся при любой ситуации", "Не сдамся, какой бы серьёзной ни была ситуация", "Не считаю ситуацию серьёзной", "Уже сдался"], "correct": 1, "solution": "Ne kadar … olursa olsun — уступительная конструкция: «как бы ни было …»." },
      { "level": "C1", "section": "Лексика", "q": "«Gelişmeler ışığında karar vermek zorundayız» — мы…", "options": ["Должны принять решение в свете событий", "Приняли решение вчера", "Не можем принять решение", "Ждём событий"], "correct": 0, "solution": "Gelişmeler ışığında — «в свете событий» (устойчивое выражение)." },
      { "level": "C1", "section": "Понимание", "q": "«Onun söyledikleri tamamen gerçek dışı» — то, что он сказал…", "options": ["Полностью правда", "Полностью ложно", "Частично верно", "Нужно проверить"], "correct": 1, "solution": "Gerçek dışı — «не соответствующий действительности, ложный»." },
      { "level": "C1", "section": "Лексика", "q": "«Bu projeyi zamanında bitirmemiz şart» — это значит…", "options": ["Необязательно заканчивать проект вовремя", "Обязательно нужно закончить проект вовремя", "Проект уже закончен", "Проект отменён"], "correct": 1, "solution": "Şart — «обязательно, непременное условие»." },
      { "level": "C1", "section": "Понимание", "q": "«Hiçbir şey eskisi gibi olmayacak» — …", "options": ["Всё останется как прежде", "Ничто не будет как прежде", "Всё стало лучше", "Ничего нового не произойдёт"], "correct": 1, "solution": "Eskisi gibi — «как раньше», olmayacak — «не будет»." }
    ]
  }
